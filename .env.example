# Supabase project (Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# anon (public) key: used server-side for Auth (magic links, cookie sessions)
SUPABASE_ANON_KEY=your-anon-key
# service-role key: used server-side only, for the workshop table. The project
# is shared with another app, so this key can read that app's table too.
SUPABASE_SERVICE_KEY=your-service-role-key
# Table that holds the workshop session (default: workshop_sessions)
SUPABASE_TABLE=workshop_sessions

# Who may sign in. Only these addresses receive a magic link. The local part
# must start with the participant's id: jung…, rehan…, harry….
ALLOWED_EMAILS=jung@example.com,rehan@example.com,harry@example.com

# Development only (ignored in production builds): act as this allowlisted
# address without Supabase Auth. Override per browser with a cookie
# `nw-dev-user=<email>` to test as another participant.
# AUTH_DEV_EMAIL=jung@example.com

# Anthropic API key for the transcript debrief and the AI practice counterpart.
# Server only; never sent to the browser. Model: claude-sonnet-5-5.
ANTHROPIC_API_KEY=sk-ant-...
